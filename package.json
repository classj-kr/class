    "audit:links": "node scripts/audit-site-links.mjs",
    "test:coach-quality": "node --test tests/board-coach-quality.test.cjs tests/board-coach-hints.test.cjs",
    "test:coach-opponent": "node --test tests/board-coach-opponent.test.cjs",
    "test:coach-feedback:ui": "node tests/board-coach-feedback-browser.cjs --regression",
    "test:coach-usability": "node tests/board-coach-usability.cjs",
    "test:coach-appearance": "node tests/board-coach-appearance.cjs",
    "test:coach-arena": "node tests/board-coach-quality.cjs",
    "test:janggi-coach": "node --test tests/janggi-coach.test.cjs tests/janggi-commentary.test.cjs",
    "test:janggi-coach:ui": "node tests/janggi-coach-browser.cjs",
    "test:janggi-commentary:ui": "node tests/janggi-commentary-browser.cjs",
    "test:janggi-motion:ui": "node tests/janggi-motion-browser.cjs",
    "test:chess-coach": "node --test tests/chess-coach.test.cjs && node tests/chess-rules-unit.js && node tests/chess-server-unit.js && node tests/chess-ui-contract.js",
