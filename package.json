    "test:board-coach": "node --test tests/board-coach.test.cjs && node tests/omok-unit.js",
    "test:board-coach:ui": "node tests/board-coach-browser.cjs",
    "test:learning-boards": "node --test tests/learning-boards.test.cjs",
    "test:learning-boards:ui": "node tests/learning-boards-browser.cjs",
    "build": "npm --prefix game-hub-server install",
    "start": "npm --prefix game-hub-server start",
    "test:beantrading": "node --test game-hub-server/beantrading.test.mjs tests/beantrading-strategy.test.cjs && node tests/beantrading-server-integration.js",
    "test:beantrading:ui": "node tests/beantrading-browser.cjs",
    "test:math-ox": "node --test tests/math-ox-data.test.js",
    "test:curriculum": "node tests/curriculum-reference-contract.js && node tests/science-lab-curriculum-contract.js",
    "test:science-scope": "node --test tests/science-grade-scope.test.cjs",
    "test:science-apps": "node --test tests/science-all-apps.test.cjs",
    "test:science-models": "node --test tests/science-supplement-models.test.cjs",
    "test:science-required": "node --test tests/science-required-core.test.cjs",
    "test:science-audit": "node --test tests/science-scope-metadata.test.cjs && node scripts/build-current-science-audit.cjs --check",
    "test:body-explorer": "node --test tests/circulation-contract.js tests/digestion-contract.js tests/respiration-contract.js tests/nervous-contract.js tests/immune-contract.js tests/movement-contract.js tests/excretion-contract.js tests/temperature-contract.js tests/body-explorer-atlas-contract.js tests/body-explorer-viewport-contract.js tests/body-explorer-classroom-contract.js && node tests/circulation-server-integration.js && node tests/digestion-server-integration.js && node tests/respiration-server-integration.js && node tests/nervous-server-integration.js && node tests/immune-server-integration.js && node tests/movement-server-integration.js && node tests/excretion-server-integration.js && node tests/temperature-server-integration.js",
    "test:graph-board": "node --test tests/graph-board-core.test.cjs tests/graph-analysis.test.cjs && node tests/graph-studio-typography-contract.js",
    "test:graph-board:ui": "node --test tests/graph-board-ui.test.cjs"
