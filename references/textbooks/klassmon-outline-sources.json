    ,{"url":"https://klassmon.com/textbook/chasi.ez?textbookSeq=d09a77ee18764338b32131e021c8b42a&grade=4&term=1&subject=SC004","title":"미술 4","author":"김해경","groups":[{"unit":["1 미술과 나누는 대화","1. 미술로 가득한 세상"],"lessons":[["1~3차시","생활 속 미술에 관심을 가지고 미술의 특징과 역할에 대해 조사하기"],["4차시","생활 속 미술의 특징과 역할의 사례를 들어 발표하고 설명하기"]]},{"unit":["1 미술과 나누는 대화","2. 선이 그리는 마음"],"lessons":[["1~2차시","선의 특징을 알고 다양한 재료와 표현 방법으로 선을 표현하기"],["3~4차시","선의 특징을 활용하여 주제에 알맞게 작품을 표현하고 선의 아름다움을 감상하기"]]},{"unit":["1 미술과 나누는 대화","3. 우리가 만드는 교실"],"lessons":[["1~2차시","친구들과 함께 교실을 새롭게 꾸밀 계획을 세우기"],["3~5차시","교실 꾸미기 계획에 따라 친구들과 교실을 꾸미기"],["6차시","새롭게 바꾼 교실에 대해 친구들과 이야기 나누기"]]},{"unit":["1 미술과 나누는 대화","4. 감각을 여는 미술"],"lessons":[["1~2차시","주변 대상을 체험하며 그 대상의 특징을 알고 느낌과 생각을 다양하게 표현하기"],["3~4차시","다양한 감각을 활용하여 감상할 수 있는 작품을 만들기"]]},{"unit":["1 미술과 나누는 대화","5. 요리 보고 조리 보고"],"lessons":[["1~2차시","대상을 관찰하는 방법을 알고 식물을 자세히 그리기"],["3~4차시","곤충을 관찰하고 자세하게 표현하며 곤충을 표현한 작품을 감상하기"]]},{"unit":["1 미술과 나누는 대화","6. 마음을 담은 그릇"],"lessons":[["1~2차시","찰흙으로 그릇 만드는 순서를 알고 그릇을 만들기"],["3~4차시","여러 가지 점토로 음식과 어울리는 그릇을 만들기"],["5~6차시","내가 만든 그릇으로 상차림하기"]]},{"unit":["1 미술과 나누는 대화","7. 알면 알수록 보면 볼수록"],"lessons":[["1~3차시","미술 작품과 미술가에 관해 궁금한 점 찾아보기"],["4~5차시","미술 작품과 미술가를 조사하는 방법 알아보기"],["6차시","미술 보고서 발표하기"]]},{"unit":["1 미술과 나누는 대화","미술로 소통해요-함께 나누는 기쁨"],"lessons":[["1-2차시","우리들의 나눔 장터 하기"]]},{"unit":["2 미술 속으로 풍덩","8. 경험을 떠올리며"],"lessons":[["1~2차시","다양한 경험을 떠올리고 작품으로 표현하고 싶은 것을 찾기"],["3~4차시","경험을 다양한 방법으로 표현하고 작품을 소중히 여기는 태도 갖기"]]},{"unit":["2 미술 속으로 풍덩","9. 찍어서 표현해요"],"lessons":[["1~2차시","화의 다양한 모습 알아보기"],["3~4차시","판화의 제작 방법을 익혀 판을 만들고 찍어서 표현하기(종이 판화)"],["5~6차시","판화 작품 감상하기"]]},{"unit":["2 미술 속으로 풍덩","10. 아름다운 옛 글씨"],"lessons":[["1~2차시","판본체의 특징을 알고 붓글씨를 쓰는 바른 자세를 익히기"],["3~4차시","판본체의 자형을 익히고 자형에 맞게 ‘미소’를 쓰기"],["5~6차시","붓글씨를 쓰는 활동에 흥미를 가지고 판본체의 자형에 맞게 ‘우리 하늘’을 쓰기"]]},{"unit":["2 미술 속으로 풍덩","11. 빛으로 보는 세상"],"lessons":[["1~2차시","빛의 특성과 아름다움을 알고 설명하기"],["3~4차시","그림자를 이용한 재미있는 놀이하기"],["5~6차시","그림자극 감상하기"]]},{"unit":["2 미술 속으로 풍덩","12. 바스락바스락 종이 놀이"],"lessons":[["1~2차시","종이의 쓰임 알아보기"],["3~4차시","다양한 종류의 종이 탐색하기"],["5~6차시","종이로 표현하기"],["7~8차시","종이로 만든 작품 감상하기"]]},{"unit":["2 미술 속으로 풍덩","13. 작품과 나누는 대화"],"lessons":[["1차시","종이로 만든 작품 감상하기"],["2~3차시","질문 만드는 방법 알아보기"],["4~5차시","미술 작품을 감상하고 질문 만들기"],["6차시","미술 작품을 감상하고 이야기 나누기"]]},{"unit":["2 미술 속으로 풍덩","미술로 소통해요-우리들의 전시회"],"lessons":[["1-2차시","우리들의 전시회 하기"]]}]}
    ,{"url":"https://klassmon.com/textbook/chasi.ez?textbookSeq=70e89f5820ee4b3987c9913e58541f8c&grade=4&term=1&subject=SC005","title":"체육 4","author":"김방출","groups":[{"unit":["1 운동","1. 건강 생활 습관을 길러요"],"lessons":[["1차시","단원 들어가기"],["2-3차시","건강한 생활 습관을 알아봐요"],["4-5차시","몸을 깨끗이 해요"],["6-7차시","바른 자세로 생활해요"],["8-9차시","균형 잡힌 몸을 만들어요"],["10-11차시","바른 식습관을 길러요"],["12-13차시","건강한 마음으로 생활해요"]]},{"unit":["1 운동","2. 운동 생활 습관을 길러요"],"lessons":[["14차시","운동과 건강의 관계를 알아봐요"],["15-16차시","생활 속에서 맨손 체조를 해요"],["17-18차시","여유롭게 산책해요"],["19-20차시","힘차게 계단을 올라요"],["21-22차시","생활 속 운동 기구를 이용해요"],["23-24차시","생각 발전소"],["25차시","되돌아 보기"]]},{"unit":["2 스포츠","1. 기술형 스포츠의 움직임을 익혀요"],"lessons":[["1차시","단원 들어가기"],["2~4차시","앞뒤 구르기를 해요"],["5~6차시","옆돌기를 해요"],["7~8차시","전력 달리기를 해요"],["9~11차시","엎드려 헤엄쳐요"],["12~14차시","누워서 헤엄쳐요"],["15~16차시","발차기를 해요"]]},{"unit":["2 스포츠","2. 전략형 스포츠의 움직임을 익혀요"],"lessons":[["17~20차시","공을 던지고 잡아요"],["21~24차시","공을 몰아요"],["25~28차시","공을 차고 멈추어요"],["29~32차시","공을 치고 받아요"],["33~36차시","라켓으로 공을 쳐요"]]},{"unit":["2 스포츠","3. 생태형 스포츠의 움직임을 익혀요"],"lessons":[["37~40차시","균형 잡고 이동해요"],["41~44차시","다양한 기구를 타고 버텨요"],["45~48차시","주변에 있는 기구를 잡고 올라요"],["49차시","생각 발전소"],["50차시","되돌아보기"]]},{"unit":["3 표현","1. 모방 표현을 해요"],"lessons":[["1차시","단원 들어가기"],["2-3차시","사물을 표현해요"],["4-5차시","인물을 따라 하며 표현해요"],["6-7차시","자연의 모습을 표현해요"]]},{"unit":["3 표현","2. 추상 표현을 해요"],"lessons":[["8-9차시","언어를 표현해요"],["10-11차시","생각과 느낌을 표현해요"],["12-13차시","계절에 대한 생각과 느낌을 표현해요"]]},{"unit":["3 표현","3. 리듬 표현을 해요"],"lessons":[["14차시","리듬을 찾아 표현해요"],["15차시","박자에 맞춰 표현해요"],["16-17차시","강약과 빠르기에 맞춰 표현해요"],["18-19차시","패턴에 맞춰 표현해요"]]},{"unit":["3 표현","4. 도구 표현을 해요"],"lessons":[["20-21차시","줄과 천으로 표현해요"],["22-23차시","공과 훌라후프로 표현해요"],["24-25차시","도구를 만들어 표현해요"],["26차시","생각 발전소"],["27차시","되돌아보기"]]}]}
    ,{"url":"https://klassmon.com/textbook/chasi.ez?textbookSeq=343a9b5881e143b8a8f33dc5f6bc5b90&grade=5&term=1&subject=SC004","title":"미술5","author":"김해경","groups":[{"unit":["1 미술을 만나자","1. 색의 어울림"],"lessons":[["1~2차시","색의 명도와 채도 이해하고 다양한 색의 배치를 통해 탐색하기"],["3-4차시","색의 배치를 다양하고 자유롭게 시도하여 어울리는 색으로 주제를 표현하기"]]},{"unit":["1 미술을 만나자","2. 상상 속 세상"],"lessons":[["1차시","재미있는 발상으로 표현된 작품 감상하기"],["2차시","발상 방법 알아보기"],["3차시","사물로 상상 표현하기"],["4차시","상상의 세계를 표현한 작품을 감상하기"]]},{"unit":["1 미술을 만나자","3. 의미를 담은 시각 기호"],"lessons":[["1차시","생활 속에서 사용되는 다양한 시각 기호 알아보기"],["2~3차시","일상에서 필요한 픽토그램 만들기"],["4~5차시","친구를 응원하는 이모티콘 만들기"],["6차시","작품 감상하기"]]},{"unit":["1 미술을 만나자","4. 마음을 담은 공예품"],"lessons":[["1~2차시","다양한 공예품의 특성을 이해하고 실을 이용한 공예품 만들기"],["3~4차시","내가 만든 문양을 이용한 공예품 만들기"]]},{"unit":["1 미술을 만나자","5. 나를 발견해요"],"lessons":[["1~2차시","자신에게 의미 있는 것을 알고 느낌과 생각을 다양하게 표현해 보기"],["3~4차시","다양한 감각을 활용하여 자신과 대상을 탐색하고 느낌과 생각을 다양한 방법으로 표현해 보기"]]},{"unit":["1 미술을 만나자","6. 붙여서 표현해요"],"lessons":[["1~2차시","우리 주변에 있는 다양한 재료의 특성을 탐색하고 이해하기"],["3~4차시","주제에 어울리는 재료를 탐색하고, 활용하여 콜라주 작품으로 표현하기"],["5~6차시","다양한 표현 재료와 용구를 탐색하여 주제를 잘 드러내기"]]},{"unit":["1 미술을 만나자","7. 우리 곁의 미술 문화"],"lessons":[["1~2차시","우리 지역의 미술 문화 행사를 알아보고 참여하기"],["3~4차시","미술 문화 행사에 참여한 경험을 돌아보고 자신의 느낌과 생각을 기록하기"],["5~6차시","미술 문화 행사에 참여한 경험을 다양한 방법으로 공유하기"]]},{"unit":["2 미술 여행을 떠나자","8. 우리 모두를 위한 디자인"],"lessons":[["1차시","모두를 위한 디자인 알아보기"],["2~3차시","생활을 편리하게 하는 제품 디자인하기"],["4~5차시","모두를 위해 디자인하기"],["6차시","모두를 위한 디자인 감상하기"]]},{"unit":["2 미술 여행을 떠나자","9. 공연이 펼쳐지는 무대"],"lessons":[["1~2차시","우리 주변에 있는 다양한 무대의 특성을 탐색하고 이해하기"],["3~4차시","공연과 잘 어울리도록 다양한 방법으로 무대 만들기"],["5~6차시","공연과 어울리는 무대를 만들려고 노력하기"]]},{"unit":["2 미술 여행을 떠나자","10. 먹과 색에서 멋을 느끼며"],"lessons":[["1~2차시","수묵 담채화를 그리는 재료와 용구의 사용 방법을 알고, 수묵 담채화의 특징 말하기"],["3~4차시","수묵 담채화의 표현 방법을 익히고 수묵 담채화로 표현하기"],["5~6차시","수묵 담채화의 특징을 살려 주제를 수묵 담채화로 표현하고자 노력하기"]]},{"unit":["2 미술 여행을 떠나자","11. 재미있는 입체 표현"],"lessons":[["1~2차시","동물의 특징을 살려 부조로 표현하기"],["3~4차시","사람의 움직임이 드러나게 다양한 재료로 표현하기"]]},{"unit":["2 미술 여행을 떠나자","12. 역사를 담은 미술"],"lessons":[["1차시","병풍과 의궤, 기록화 알아보기"],["2차시","의궤 속 기록화의 특징 알아보기"],["3차시","우리들의 의궤 만들기"],["4차시","작품 감상하기"]]},{"unit":["2 미술 여행을 떠나자","13. 미술 추리단"],"lessons":[["1차시","미술 작품을 작품의 배경과 연결하여 감사는 방법 알기"],["2차시","미술가와 미술 작품에 관한 이야기를 읽고 작품의 배경과 연결하여 작품을 감상하기"],["3~4차시","미술가와 미술 작품에 관해 조사하고 작품을 배경과 연결하여 감상하기"],["5~6차시","미술가와 미술 작품에 관한 조사한 내용을 바탕으로 연구 보고서 쓰기"]]},{"unit":["2 미술 여행을 떠나자","다함께 정리해요-누구나 즐기는 전시회"],"lessons":[["1~2차시","누구나 즐기는 전시 방법을 알고 전시회를 준비하여 참여하기"]]}]}
