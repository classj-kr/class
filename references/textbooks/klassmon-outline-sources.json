    ,{"url":"https://klassmon.com/textbook/chasi.ez?textbookSeq=e8af803257c54483b36451e9f396cccd&grade=6&term=1&subject=SC004","title":"미술6","author":"김해경","groups":[{"unit":["1 한눈에 반한 미술","1. 생각을 전하는 광고"],"lessons":[["1~2차시","광고에 담긴 의미와 표현 방법 찾기"],["3~4차시","내 생각을 전달하는 광고 만들기"]]},{"unit":["1 한눈에 반한 미술","2. 다양한 조형 원리"],"lessons":[["1~2차시","조형 요소의 어울림을 탐색하고 다양한 조형 원리 이해하기"],["3~4차시","조형 요소와 원리를 활용하여 주제에 알맞게 표현하기"]]},{"unit":["1 한눈에 반한 미술","3. 나만의 움직이는 장난감"],"lessons":[["1~2차시","오토마타의 작동 원리를 활용하여 오토마타 작품 만들기"],["3~4차시","오토마타의 작동 원리를 활용하여 개성 있는 오토마타 작품 만들기"],["5~6차시","오토마타의 작동 원리를 생각하며 오토마타 감상하기"]]},{"unit":["1 한눈에 반한 미술","4. 내가 바라본 세상"],"lessons":[["1~2차시","나에게 소중하고 의미 있는 물건을 찾아보고 어울리는 새 이름 지어 보기"],["3~4차시","나에게 소중한 사람들의 사진을 찍어 전시하기"]]},{"unit":["1 한눈에 반한 미술","5. 정물과 풍경을 담은 그림"],"lessons":[["1~3차시","사물의 특징을 살려 정물화로 표현하기"],["4~6차시","원근감을 살려 풍경화로 표현하기"]]},{"unit":["1 한눈에 반한 미술","6. 공간을 만드는 예술, 건축"],"lessons":[["1~3차시","입체 도형의 모양을 생각하며 건축물 구조를 만들기"],["4~6차시","공간을 생각하며 아름다운 건축물 모형 만들기"]]},{"unit":["1 한눈에 반한 미술","7. 같은 작품, 다른 감상"],"lessons":[["1~2차시","다양한 감상 방법을 알고 우리나라 전통 미술과 현대 미술을 비교 감상하 기"],["3차시","감상 방법을 활용하여 다양한 미술 작품을 감상하고 작품에 대한 다른 사 람의 관점을 존중하기"],["4차시","미술 카드 게임을 하며 작품을 감상하기"]]},{"unit":["2 미술에 물들자","8. 지속 가능한 미술"],"lessons":[["1차시","지속 가능한 미래를 위한 미술의 의미와 필요성 이해하기"],["2차시","새 활용 작품 표현을 위한 재료 탐색하기 및 제작하기"],["3차시","더 나은 미래를 위한 지속 가능 캠페인 기획하기"],["4차시","지속 가능성을 주제로 한 미술 작품을 감상하고 자기 생각 표현하기"]]},{"unit":["2 미술에 물들자","9. 찍어서 표현해요"],"lessons":[["1차시","다양한 판화 살펴보기"],["2차시","평판화(모노타이프)로 표현하기"],["3차시","공판화(스텐실)로 표현하기"],["4차시","다양한 판화 작품 감상하기"]]},{"unit":["2 미술에 물들자","10. 움직이는 그림, 애니메이션"],"lessons":[["1~2차시","사물에 변화를 주어 사진을 찍고, 스톱 모션 기법으로 사진을 연결해 봄으로써 애니메이션의 원리 이해하기"],["3~6차시","과정의 변화가 있는 내용을 선정하여 스톱 모션 애니메이션 작품 만들기"]]},{"unit":["2 미술에 물들자","11. 디지털 매체 속 미술"],"lessons":[["1~2차시","인공지능 도구 활용해 그림 그리기"],["3~4차시","디지털 매체로 표현·전시 및 감상하기"]]},{"unit":["2 미술에 물들자","12. 아름다운 한글, 궁체"],"lessons":[["1~2차시","궁체를 쓰는 바른 자세와 궁체의 특징 설명하기"],["3~4차시","궁체를 쓰는 자세와 궁체의 기본 획을 익혀 자형에 맞게 ‘나무’ 쓰기"],["5~6차시","궁체를 바른 자세와 태도로 쓰려고 노력하기"]]},{"unit":["2 미술에 물들자","13. 작품을 감상해요"],"lessons":[["1~2차시","작품의 내용과 형식을 알고 감상 방법을 익혀 작품을 감상하기"],["3~4차시","마음에 드는 작품을 골라 감상하고 작품에 대한 자신의 느낌과 생각을 미술 용어를 활용하여 설명하기"]]},{"unit":["2 미술에 물들자","미술로 소통해요-메타버스로 즐기는 전시회"],"lessons":[["1-2차시","메타버스를 활용한 새로운 전시 방법을 알고, 전시회를 준비하여 참여하기"]]}]}
    ,{"url":"https://klassmon.com/textbook/chasi.ez?textbookSeq=f3a06e42a64b43c7940f9f4042cd8b0f&grade=6&term=1&subject=SC005","title":"체육","author":"김방출","groups":[{"unit":["1 운동","1. 운동 체력을 길러요"],"lessons":[["1차시","단원 들어가기"],["2~3차시","운동 체력을 알아봐요"],["4~5차시","순발력을 길러요"],["6~7차시","민첩성을 길러요"],["8~9차시","평형성을 길러요"],["10~11차시","협응성을 길러요"]]},{"unit":["1 운동","2. 안전하게 활동해요"],"lessons":[["12차시","운동 시설과 용·기구를 안전하게 이용해요"],["13~14차시","안전하게 지상 운동을 해요"],["15~16차시","안전하게 수상·빙상 운동을 해요"],["17~18차시","일상생활 속 위험 상황에 안전하게 대처해요"],["19~20차시","자연재해에 안전하게 대처해요"],["21~22차시","생각 발전소"],["23차시","되돌아보기"]]},{"unit":["2 스포츠","1. 동작형 스포츠를 해요"],"lessons":[["1차시","단원 들어가기"],["2~3차시","매트에서 다리 벌려 굴러요"],["4~5차시","매트에서 손 짚고 옆돌기를 해요"],["6~7차시","뜀틀에서 손 짚고 다리 벌려 뛰어넘기를 해요"],["8~9차시","뜀틀에서 손 짚고 앞구르기를 해요"],["10~11차시","평균대에서 걷기, 방향 바꾸기, 뛰기를 해요"]]},{"unit":["2 스포츠","2. 투기형 스포츠를 해요"],"lessons":[["12~15차시","씨름 활동을 해요"],["16~19차시","태권도 활동을 해요"]]},{"unit":["2 스포츠","3. 네트형 스포츠를 해요"],"lessons":[["20~23차시","배구형 게임의 기본 기능을 익혀요"],["24~25차시","배구형 게임의 전략을 익혀요"],["26~27차시","배구형 게임을 해요"],["28~29차시","족구형 게임의 기본 기능을 익혀요"],["30~31차시","전략을 익혀 족구형 게임을 해요"],["32~35차시","배드민턴형 게임의 기본 기능을 익혀요"],["36~37차시","배드민턴형 게임의 전략을 익혀요"],["38~39차시","배드민턴형 게임을 해요"],["40~41차시","탁구형 게임을 해요"],["42~43차시","테니스형 게임을 해요"]]},{"unit":["2 스포츠","4. 자연환경형 스포츠를 해요"],"lessons":[["44차시","오리엔티어링을 해요"],["45차시","등산 활동을 해요"],["46차시","캠핑 활동을 해요"],["47차시","수상 활동을 해요"],["48~49차시","설상 활동을 해요"],["50~51차시","승마 활동을 해요"],["52~53차시","생각 발전소"],["54차시","되돌아보기"]]},{"unit":["3 표현","1. 음악줄넘기 활동을 해요"],"lessons":[["1차시","단원 들어가기"],["2~3차시","음악줄넘기를 해요"],["4~6차시","음악줄넘기 작품을 창작해요"]]},{"unit":["3 표현","2. 여러 나라의 민속 무용 활동을 해요"],"lessons":[["7~8차시","마임을 춤추며 기쁨을 표현해요"],["9~10차시","버지니아 릴을 춤추며 축제를 즐겨요"],["11~12차시","대나무를 피하는 새처럼 티니클링을 춰요"],["13~15차시","세계 민속 무용 축제를 열어요"]]},{"unit":["3 표현","3. 댄스스포츠와 스트리트댄스 활동을 해요"],"lessons":[["16~19차시","짝과 함께 댄스스포츠를 춰요"],["20~21차시","자유롭게 스트리트댄스를 춰요"],["22~23차시","스트리트댄스 발표회를 열어요"],["24차시","생각 발전소"],["25차시","되돌아보기"]]}]}
