{
  "name": "classroom-game-hub-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "postinstall": "node render-postinstall.mjs",
    "build:reading-seed": "node ../scripts/build-reading-seed.js",
    "test:school-election": "node --test school-election.test.mjs voting-auth.test.mjs voting-contract.test.mjs",
    "test:school-election:ui": "node -e \"process.env.RUN_ELECTION_UI='1'; import('./school-election-ui.test.mjs')\"",
    "preview:school-election": "node school-election-preview.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "google-auth-library": "^11.0.0",
    "pg": "^8.13.1",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "playwright": "^1.63.0"
  }
}
