{
  "manifest_version": 3,
  "name": "NEIS 붙여넣기 - ClassJ",
  "version": "0.3.2",
  "description": "생활기록부 도우미가 만든 학생별 문장을 나이스 학기말종합의견 화면에 이름을 대조해 한 번에 채웁니다. 저장은 나이스에서 직접 누릅니다.",
  "homepage_url": "https://classj.kr/classtools/neis-fill/",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "NEIS 붙여넣기 - ClassJ",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.neis.go.kr/*"
  ]
}
