{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "pretest": "npm run audit:middle-repetition && npm run audit:high-repetition && npm run audit:stem-repetition",
    "audit:middle-repetition": "node --experimental-strip-types scripts/audit-middle-repetition.ts",
    "audit:high-repetition": "node --experimental-strip-types scripts/audit-high-school-repetition.ts",
    "audit:stem-repetition": "node --experimental-strip-types scripts/audit-stem-foundation-repetition.ts",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run typecheck && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "types:generate": "wrangler types --config wrangler.types.jsonc",
    "audit:browser": "node scripts/audit-browser.cjs && node scripts/audit-measurement-grading.cjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "katex": "^0.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
