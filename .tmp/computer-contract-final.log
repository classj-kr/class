x1="15" y1="24" x2="28" y2="24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>\r\n              <line x1="15" y1="30" x2="23" y2="30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>\r\n              <line x1="26" y1="28" x2="26" y2="32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>\r\n            </svg>\r\n          </div>\r\n          <div class="card-body">\r\n            <span class="mode-en">Sentence Practice</span>\r\n            <strong class="mode-ko">문장 연습</strong>\r\n          </div>\r\n        </button>\r\n      </div>\r\n    </section>\r\n\r\n    <section id="recordsCard" class="records-card" aria-labelledby="recordsTitle" hidden>\r\n      <div class="practice-heading"><h2 id="recordsTitle">내 기록</h2></div>\r\n      <div id="recordsList" class="records-list"></div>\r\n      <button id="resetRecordsButton" class="secondary reset-records" type="button">기록 초기화</button>\r\n    </section>\r\n\r\n    <section id="fingerGuide" class="finger-guide" aria-labelledby="guideTitle" hidden>\r\n      <div class="guide-head"><h2 id="guideTitle">손가락 자리</h2><div class="segmented guide-language" aria-label="운지법 종류"><button class="active" type="button" data-guide-language="ko" aria-pressed="true">가 한글</button><button type="button" data-guide-language="en" aria-pressed="false">a 영어</button><button type="button" data-guide-language="symbols" aria-pressed="false">123 숫자·기호</button></div></div>\r\n      <div id="guideStages" class="guide-stages" aria-label="자리 익히기 단계"></div>\r\n      <div class="finger-stage">\r\n        <div class="hands" aria-label="양손 손가락 안내 그림">\r\n          <img class="hand-illustration" src="assets/touch-typing-hands.webp" alt="키보드 기본 자세를 위한 왼손과 오른손">\r\n          <div class="hand left-hand"><span class="finger pinky" data-finger="lp"><i></i><b>새끼</b></span><span class="finger ring" data-finger="lr"><i></i><b>약지</b></span><span class="finger middle" data-finger="lm"><i></i><b>가운데</b></span><span class="finger index" data-finger="li"><i></i><b>검지</b></span><span class="finger thumb" data-finger="lt"><i></i><b>엄지</b></span><div class="palm">왼손</div></div>\r\n          <div class="hand right-hand"><span class="finger thumb" data-finger="rt"><i></i><b>엄지</b></span><span class="finger index" data-finger="ri"><i></i><b>검지</b></span><span class="finger middle" data-finger="rm"><i></i><b>가운데</b></span><span class="finger ring" data-finger="rr"><i></i><b>약지</b></span><span class="finger pinky" data-finger="rp"><i></i><b>새끼</b></span><div class="palm">오른손</div></div>\r\n        </div>\r\n        <div class="finger-instruction" aria-live="polite"><span id="fingerBadge">왼손 검지</span><strong id="guideKey">ㄹ</strong><p id="guideMessage">노란색으로 표시된 손가락으로 <b>ㄹ</b> 키를 눌러 보세요.</p></div>\r\n      </div>\r\n      <div id="keyboard" class="keyboard" aria-label="키보드 운지법"></div>\r\n      <div class="guide-progress"><span id="guideCount">0 / 12</span><div><i id="guideBar"></i></div></div>\r\n      <div class="actions"><button id="guideNextButton" class="primary" type="button" hidden>다음 단계</button><button id="startWordsButton" class="secondary" type="button">낱말 연습으로 건너뛰기</button></div>\r\n    </section>\r\n    <section class="practice" aria-labelledby="practiceTitle" hidden>\r\n      <div class="practice-heading"><h2 id="practiceTitle">단어 연습</h2></div>\r\n      <div id="practiceFilters" class="practice-filters" aria-label="연습 범위"></div>\r\n      <div class="mode-row">\r\n        <div id="languageControls" class="segmented" aria-label="연습 언어">\r\n          <button class="active" type="button" data-language="ko" aria-pressed="true">가 한글</button>\r\n          <button type="button" data-language="en" aria-pressed="false">A 영어</button>\r\n          <button type="button" data-language="symbols" aria-pressed="false">123 숫자·기호</button>\r\n          <button type="button" data-language="avatars" aria-pressed="false">아바타</button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class="stats" aria-label="현재 연습 기록">\r\n        <div><span>타수</span><strong id="speed">0</strong><small>타/분</small></div>\r\n        <div><span>정확도</span><strong id="accuracy">100</strong><small>%</small></div>\r\n        <div><span>연속 성공</span><strong id="streak">0</strong><small>개</small></div>\r\n      </div>\r\n\r\n      <div class="prompt-card">\r\n        <p class="eyebrow"><span id="stepLabel">1 / 10</span><span id="bestLabel">최고 0타/분</span></p>\r\n        <div class="prompt-stage"><img id="avatarPrompt" class="avatar-prompt" alt="" hidden><div class="prompt-copy"><div id="prompt" class="prompt" aria-label="따라 쓸 글자"></div><p id="promptLiteral" class="prompt-literal" hidden></p></div><button id="audioPromptButton" class="tts-button" type="button" aria-label="발음 다시 듣기" title="발음 다시 듣기" hidden>🔊</button></div>\r\n        <label for="typingInput">위의 글자를 그대로 입력하세요</label>\r\n        <textarea id="typingInput" rows="1" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="done" aria-describedby="feedback"></textarea>\r\n        <p id="feedback" class="feedback" aria-live="polite">준비되면 바로 입력해 보세요!</p>\r\n        <div class="progress"><span id="progressBar"></span></div>\r\n      </div>\r\n\r\n      <p class="keyboard-tip">글자를 모두 맞게 입력한 뒤 <kbd>Enter</kbd>를 누르면 다음 문제로 넘어가요.</p>\r\n    </section>\r\n\r\n    <section id="resultCard" class="result-card" hidden aria-live="polite">\r\n      <div class="medal" aria-hidden="true">★</div>\r\n      <p>연습 완료!</p>\r\n      <h2 id="resultTitle">참 잘했어요!</h2>\r\n      <div class="result-stats"><span>평균 타수 <b id="resultSpeed">0</b></span><span>정확도 <b id="resultAccuracy">100%</b></span></div>\r\n      <button id="againButton" class="primary" type="button">한 번 더 연습하기</button>\r\n    </section>\r\n  </main>\r\n  <script src="avatar-words.js"></script>\r\n  <script src="../../../literacy-numeracy/proverbs/proverbs-data.js"></script>\r\n  <script src="app.js?v=20260917-reading-words"></script>\r\n</body>\r\n</html>\r\n',
    expected: /app\.js\?v=20260910-fix-back-navigation/,
    operator: 'match',
    diff: 'simple'
